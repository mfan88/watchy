# Copy to .env.local (never commit it).
# Secret path segment of the home server.
HTV_SECRET=
HTV_BASE_URL=https://tv.zuxi.me
# >= 32 random chars: openssl rand -base64 48
SESSION_SECRET=
# Comma-separated user:bcrypt-hash. Generate with: npm run hash-user -- <name> <password>
# In .env.local every "$" in the hash must be written as "\$" (the script prints that form).
HTV_USERS=
